SELECT Nome FROM Professores -- mostrar apenas a tabela informada
SELECT Nome AS NomeDoaluno, Turma AS Sala FROM Alunos; -- Apelido para deixar o titulo mais claro na resposta

-- CONSULTA POR ORDEM ALFABETICA
SELECT Nome, Turma FROM Alunos
ORDER BY Nome ASC; -- ASC -> ORDEM DECRESCENTE

-- OS 5 PRIMEIROS
SELECT TOP 5 Nome, Turma, DataNascimento FROM Alunos
ORDER BY Nome;

-- FILTROS COM WHERE
-- WHERE -> FILTRA AS LINHAS
SELECT Nome, Turma FROM Alunos WHERE Turma = '2INFO-A'

-- DIFERENTE DE
SELECT Nome, Turma FROM Alunos WHERE Turma <> '2INFO-A' -- <> BUSCA ELEMENTOS DIFERENTES DE 2INFO-A

-- AND -> AS 2 CONDICOES DEVEM SER VERDADEIRAS PARA QUE O REGISTRO SEJA RETORNADO NA CONSULTA (E)
SELECT Nome, Turma, DataNascimento FROM Alunos WHERE Turma = '2INFO-A' AND DataNascimento > '2008-01-01'


-- OR -> (OU) PELO MENOS UMA CONDICAO DEVE SER VERDADEIRA
SELECT Nome, Turma FROM Alunos WHERE Turma = '2INFO-A' OR DataNascimento > '2008-01-01'

-- IN -> VERSAO CURTA PARA VARIOS VALORES
SELECT Nome, Turma FROM Alunos WHERE Turma IN ('2INFO-A', '2INFO-B');

-- LIKE -> % SIGNIFICA QUALQUR QUANTIDADE DE CARACTERES E SIGNIFICA QUALQUER CARACTER
SELECT Nome, Email FROM Alunos WHERE Nome LIKE '%es'; -- SELECIONA OS NOMES E EMAILS DOS ALUNOS NOS QUAIS O EMAIL TERMINA COM '@escola.com'
