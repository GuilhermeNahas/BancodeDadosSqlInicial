CREATE TABLE Professores(
    IdProfessor int PRIMARY KEY IDENTITY (1,1),  -- IDENTITY -> Auto incremento dos ID
    Nome VARCHAR(100) NOT NULL,
    Email varchar(100) not null unique,  -- QUANDO PODE TER APENAS 1, POR EXEMPLO EMAIL, CPF e etc.
    Especialidade VARCHAR(100) not null
);

CREATE TABLE Cursos(
    IdCurso INT PRIMARY KEY IDENTITY (1,1),
    NomeCurso VARCHAR(100) NOT NULL,
    CargaHoraria INT NOT NULL CHECK (CargaHoraria > 0 AND CargaHoraria <= 200), -- CHECK -> Valida tipo um if (condicional)
    IdProfessor INT NOT NULL,
    Ativo BIT NOT NULL DEFAULT 1,
    CONSTRAINT FK_Cursos_Professores -- CRIA UMA CHAVE ESTRANGEIRA
    FOREIGN KEY (IdProfessor) REFERENCES Professores(IdProfessor)
);

CREATE TABLE Alunos(
    IdAluno int PRIMARY KEY IDENTITY (1,1),
    Nome VARCHAR(100) NOT NULL,
    Email VARCHAR(100) NOT NULL UNIQUE,
    Turma VARCHAR(100) NOT NULL,
    DataNascimento DATE NOT NULL,
    Ativo BIT NOT NULL CONSTRAINT DF_Alunos_Ativo DEFAULT 1, -- DEFAULT -> Define o valor como 1
);

CREATE TABLE Matriculas(
    IdMatricula INT PRIMARY KEY IDENTITY(1,1),
    IdAluno INT NOT NULL,
    IdCurso INT NOT NULL,
    DataMatricula DATE NOT NULL CONSTRAINT DF_Matriculas_Data DEFAULT (CONVERT(DATE, GETDATE())),
    NotaFinal DECIMAL(4,2) NULL CHECK (NotaFinal BETWEEN 0 AND 10),
    StatusMatricula VARCHAR(20) NOT NULL CONSTRAINT DF_Matriculas_Status DEFAULT 'Ativa',

    CONSTRAINT UQ_Matriculas_AlunoCurso UNIQUE (IdAluno, IdCurso),
    CONSTRAINT FK_Matriculas_Alunos
        FOREIGN KEY (IdAluno) REFERENCES Alunos(IdAluno),
    CONSTRAINT FK_Matriculas_Cursos
        FOREIGN KEY (IdCurso) REFERENCES Cursos(IdCurso)    
);

